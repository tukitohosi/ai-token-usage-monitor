{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "scripts",
    "src/core",
    "src/ui/format.ts",
    "src/ui/mock-data.ts",
    "src/ui/device-usage-view-model.ts",
    "src/ui/quota-view-model.ts",
    "tests/**/*.test.ts"
  ]
}
